{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Default SQLite database file. To switch to PostgreSQL:
    // "Database": "Host=localhost;Database=orders;Username=postgres;Password=postgres"
    // And in Program/DependencyInjection use options.UseNpgsql(...)
    // To switch to SQL Server:
    // "Database": "Server=localhost;Database=OrdersDb;Trusted_Connection=True;TrustServerCertificate=True"
    "Database": "Data Source=orders.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Outbox": {
    "IntervalMilliseconds": 5000,
    "BatchSize": 20,
    "MaxAttempts": 5
  }
}
